{
  "plugins": ["typescript", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "import/no-default-export": "error",
    "typescript/no-explicit-any": "error",
    "vitest/no-focused-tests": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_didMount", "_willUpdate", "__resources"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["*.config.ts", "examples/*/*.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "artifacts/**",
    "test-results/**",
    "playwright-report/**",
    "examples/*/dist/**",
    "examples/*/src/components/ui/**",
    "examples/*/src/lib/**",
    "test/.tmp/**",
    "integrations/vendor/**"
  ]
}
