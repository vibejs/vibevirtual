<script setup lang="ts">
import { computed } from '@usevibejs/ui';
import { lexer } from 'marked';
const { text } = defineProps<{ text: string }>();
const blocks = computed(() => lexer(text).flatMap((token) => {
  if (token.type === 'code') return [{ kind: 'code', text: token.text }];
  if (token.type === 'heading') return [{ kind: 'heading', text: token.text }];
  if (token.type === 'paragraph') return [{ kind: 'paragraph', text: token.text }];
  return [];
}));
</script>
<template><div class="message-markdown"><template v-for="(block, index) in blocks" :key="index"><pre v-if="block.kind === 'code'"><code>{{ block.text }}</code></pre><h4 v-else-if="block.kind === 'heading'">{{ block.text }}</h4><p v-else>{{ block.text }}</p></template></div></template>
